@startuml
title Добавление собеседования
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 16
skinparam sequenceArrowColor #40527A

actor "Соискатель" as U
boundary "Интерфейс" as UI
control "Контроллер (main.js)" as C
participant "Проверка и модель" as M
database "localStorage" as S

U -> UI : Открывает «Собеседования»\nи нажимает «Добавить»
UI -> C : Открыть форму собеседования
C --> UI : Выбор отклика и поля встречи
U -> UI : Выбирает отклик, задаёт дату,\nвремя, этап и формат
UI -> C : Отправить форму
C -> M : validateInterview(поля)
alt есть ошибка обязательного поля или даты
  M --> C : Сообщения об ошибках
  C --> UI : Оставить введённое, отметить ошибку
else поля корректны
  M --> C : Поля прошли проверку
  C -> M : addInterview(состояние, поля)
  opt первая встреча, статус «Отклик отправлен» или «Тестовое задание»
    M -> M : Перевести отклик в статус «Собеседование»
  end
  M --> C : Новое состояние
  C -> S : Сохранить снимок состояния
  S --> C : Результат записи
  C --> UI : Обновить список встреч
  opt запись в браузер не удалась
    C --> UI : Показать ошибку записи
  end
end
@enduml
